; Inno Setup script for win-capture-audio.
; Installs to the modern OBS per-plugin layout under %ProgramData% and, thanks to the
; unchanged AppId, automatically uninstalls any previous version first - including 2.2.x
; installs that lived inside the OBS Studio directory.

#define MyAppName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_URL@"

[Setup]
; NOTE: AppId must stay stable across versions: it is how upgrades find and remove
; previous installs. Do not change it.
AppId={{406FD363-BC38-47EE-AF53-7F6FB4D56ECE}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commonappdata}\obs-studio\plugins\{#MyAppName}
; Never reuse the directory recorded by an older install: 2.2.x-era setups
; installed into the OBS root, and inheriting that path would put the modern
; layout where OBS cannot load it.
UsePreviousAppDir=no
PrivilegesRequired=admin
; The uninstaller is run elevated (by upgrades and by Windows' "Installed apps"),
; so it must not live under %ProgramData%\obs-studio: OBS creates that tree
; unelevated, which leaves it owned by - and replaceable by - the regular user.
UninstallFilesDir={commonpf}\{#MyAppName}
DisableDirPage=yes
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
LicenseFile="@PROJECT_SOURCE_DIR@/LICENSE"
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-setup
Compression=lzma
SolidCompression=yes
VersionInfoVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription={#MyAppName} Setup
DirExistsWarning=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Files]
Source: "@RELEASE_DIR@/*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[InstallDelete]
; Old zip installs lived inside the OBS installation directory. OBS scans that
; legacy location first, so a stale DLL left there would shadow this install
; and the user would silently keep running the old version.
Type: files;          Name: "{code:GetLegacyObsDir}\obs-plugins\64bit\win-capture-audio.dll"; Check: LegacyObsDirFound
Type: files;          Name: "{code:GetLegacyObsDir}\obs-plugins\64bit\win-capture-audio.pdb"; Check: LegacyObsDirFound
Type: filesandordirs; Name: "{code:GetLegacyObsDir}\data\obs-plugins\win-capture-audio";      Check: LegacyObsDirFound
; Uninstallers that 2.3.0 - 2.3.3 kept next to the plugin (see UninstallFilesDir).
Type: files;          Name: "{app}\unins*.exe"
Type: files;          Name: "{app}\unins*.dat"

[Icons]
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppName}}"; Filename: "{#MyAppURL}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"

[Code]
var
  LegacyObsDir: String;
  LegacyObsDirChecked: Boolean;

// Locates the OBS Studio installation the same way the build does: registry
// first, then the default Program Files location. Empty when not found or
// when it does not look like a real OBS install.
function GetObsDir(): String;
begin
  if not LegacyObsDirChecked then
  begin
    LegacyObsDirChecked := True;
    if not RegQueryStringValue(HKLM64, 'SOFTWARE\OBS Studio', '', LegacyObsDir) then
      if not RegQueryStringValue(HKLM32, 'SOFTWARE\OBS Studio', '', LegacyObsDir) then
        LegacyObsDir := ExpandConstant('{commonpf64}\obs-studio');
    if not FileExists(LegacyObsDir + '\bin\64bit\obs64.exe') then
      LegacyObsDir := '';
  end;
  Result := LegacyObsDir;
end;

function LegacyObsDirFound(): Boolean;
begin
  Result := GetObsDir() <> '';
end;

function GetLegacyObsDir(Param: String): String;
begin
  Result := GetObsDir();
end;

function GetUninstallString(): String;
var
  sUnInstPath: String;
  sUnInstallString: String;
begin
  sUnInstPath := ExpandConstant('Software\Microsoft\Windows\CurrentVersion\Uninstall\{#emit SetupSetting("AppId")}_is1');
  sUnInstallString := '';
  // Machine-wide hives only. Setup runs elevated and executes this string, and
  // every release has installed per-machine; a per-user (HKCU) entry can be
  // written by any unprivileged process and must never be run as administrator.
  if not RegQueryStringValue(HKLM64, sUnInstPath, 'UninstallString', sUnInstallString) then
    RegQueryStringValue(HKLM32, sUnInstPath, 'UninstallString', sUnInstallString);
  Result := sUnInstallString;
end;

// Only Program Files is writable by administrators alone. 2.2.x installed there
// and needs its uninstaller run to remove the old layout; later versions are
// simply upgraded in place, so their uninstaller is never executed from the
// user-writable plugin directory.
function IsTrustedUninstaller(Path: String): Boolean;
var
  sPath: String;
begin
  sPath := Lowercase(ExpandFileName(Path));
  Result := (Pos(Lowercase(ExpandConstant('{commonpf64}\')), sPath) = 1) or
            (Pos(Lowercase(ExpandConstant('{commonpf32}\')), sPath) = 1);
end;

function IsUpgrade(): Boolean;
begin
  Result := (GetUninstallString() <> '');
end;

function UnInstallOldVersion(): Integer;
var
  sUnInstallString: String;
  iResultCode: Integer;
begin
// Return Values:
// 1 - uninstall string is empty
// 2 - error executing the UnInstallString
// 3 - successfully executed the UnInstallString
  Result := 0;
  sUnInstallString := GetUninstallString();
  if sUnInstallString <> '' then begin
    sUnInstallString := RemoveQuotes(sUnInstallString);
    if not IsTrustedUninstaller(sUnInstallString) then
      Result := 1
    else if Exec(sUnInstallString, '/VERYSILENT /NORESTART /SUPPRESSMSGBOXES','', SW_HIDE, ewWaitUntilTerminated, iResultCode) then
      Result := 3
    else
      Result := 2;
  end else
    Result := 1;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if (CurStep=ssInstall) then
  begin
    if (IsUpgrade()) then
    begin
      UnInstallOldVersion();
    end;
  end;
end;
